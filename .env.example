# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DB?sslmode=require&pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require"

# Auth — generate a long random string (e.g. `openssl rand -base64 48`)
AUTH_SECRET="replace-with-long-random-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin seed (used by prisma/seed.ts to provision the first admin)
ADMIN_NAME="Admin"
ADMIN_PHONE="01700000000"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeThisPassword123!"

# Optional future storage (Cloudinary). Leave blank for MVP.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Platform defaults
DEFAULT_COMMISSION_PERCENTAGE="15"
